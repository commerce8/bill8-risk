{
  "openapi": "3.1.0",
  "info": {
    "title": "bill8-risk",
    "description": "Sentin8 Bill8:Risk — rules, screening, review queue.",
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health probe payload.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Liveness (version, build)",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/reviews": {
      "get": {
        "tags": [
          "risk"
        ],
        "summary": "`GET /v1/reviews` — list the review queue.",
        "operationId": "list_reviews",
        "responses": {
          "200": {
            "description": "Review queue",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Review"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Missing bill8:risk:reviews:read"
          }
        },
        "security": [
          {
            "bill8:risk:reviews:read": []
          }
        ]
      }
    },
    "/v1/reviews/{id}/resolve": {
      "post": {
        "tags": [
          "risk"
        ],
        "summary": "`POST /v1/reviews/{id}/resolve` — resolve a review (idempotent).",
        "operationId": "resolve_review",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {}
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Review resolved"
          },
          "404": {
            "description": "Review not found"
          },
          "409": {
            "description": "Already resolved"
          }
        },
        "security": [
          {
            "bill8:risk:reviews:write": []
          }
        ]
      }
    },
    "/v1/rules": {
      "get": {
        "tags": [
          "risk"
        ],
        "summary": "`GET /v1/rules` — list rules.",
        "operationId": "list_rules",
        "responses": {
          "200": {
            "description": "List of rules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Rule"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Missing bill8:risk:rules:read"
          }
        },
        "security": [
          {
            "bill8:risk:rules:read": []
          }
        ]
      },
      "post": {
        "tags": [
          "risk"
        ],
        "summary": "`POST /v1/rules` — create a rule.",
        "operationId": "create_rule",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRuleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Rule created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Rule"
                }
              }
            }
          },
          "403": {
            "description": "Missing bill8:risk:rules:write"
          }
        },
        "security": [
          {
            "bill8:risk:rules:write": []
          }
        ]
      }
    },
    "/v1/screenings": {
      "post": {
        "tags": [
          "risk"
        ],
        "summary": "`POST /v1/screenings` — screen a charge context (M2M from payments).\nThe evaluator is pure; the outcome persists as an auditable screening.",
        "operationId": "screen",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScreenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Screening outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Screening"
                }
              }
            }
          },
          "403": {
            "description": "Missing bill8:risk:screenings:write"
          }
        },
        "security": [
          {
            "bill8:risk:screenings:write": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateRuleRequest": {
        "type": "object",
        "description": "Request body for `POST /v1/rules`.",
        "required": [
          "predicate",
          "params",
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "Action on match."
          },
          "params": {
            "description": "Predicate parameters."
          },
          "predicate": {
            "type": "string",
            "description": "Rule predicate kind."
          },
          "priority": {
            "type": "integer",
            "format": "int32",
            "description": "Evaluation priority."
          }
        }
      },
      "Review": {
        "type": "object",
        "description": "A queued manual adjudication case.",
        "required": [
          "id",
          "screening_id",
          "status",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Review id."
          },
          "resolved_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Resolution timestamp."
          },
          "screening_id": {
            "type": "string",
            "format": "uuid",
            "description": "The originating screening."
          },
          "status": {
            "type": "string",
            "description": "Lifecycle state (`open` / `approved` / `declined`)."
          }
        }
      },
      "Rule": {
        "type": "object",
        "description": "A declarative fraud rule with an action.",
        "required": [
          "id",
          "env_id",
          "predicate",
          "params",
          "action",
          "priority",
          "enabled",
          "created_at"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "Action on match (`allow` / `review` / `block`)."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp."
          },
          "enabled": {
            "type": "boolean",
            "description": "Enabled state."
          },
          "env_id": {
            "type": "string",
            "format": "uuid",
            "description": "Owning tenant environment."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Rule id."
          },
          "params": {
            "description": "Predicate parameters (threshold, list, window)."
          },
          "predicate": {
            "type": "string",
            "description": "Rule predicate kind (`amount_above` / `country_in` /\n`velocity_above`)."
          },
          "priority": {
            "type": "integer",
            "format": "int32",
            "description": "Evaluation priority (lower first)."
          }
        }
      },
      "ScreenRequest": {
        "type": "object",
        "description": "Request body for `POST /v1/screenings` (M2M from payments).",
        "required": [
          "charge_context"
        ],
        "properties": {
          "charge_context": {
            "description": "The charge context to screen (amount, currency, method, region)."
          }
        }
      },
      "Screening": {
        "type": "object",
        "description": "The outcome of screening a charge context against the rule set.",
        "required": [
          "id",
          "env_id",
          "charge_context",
          "outcome",
          "created_at"
        ],
        "properties": {
          "charge_context": {
            "description": "The screened charge context."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp."
          },
          "env_id": {
            "type": "string",
            "format": "uuid",
            "description": "Owning tenant environment."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Screening id."
          },
          "matched_rule_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The rule that decided (first match by priority)."
          },
          "outcome": {
            "type": "string",
            "description": "Outcome (`allow` / `review` / `block`) — fail-closed on evaluation\nerror (a `block`, never an `allow`)."
          }
        }
      }
    }
  }
}
